<link rel="stylesheet" href="<%- theme.jsDelivr.url %><%- url_for(theme.libs.css.aplayer) %>">
<style>
    .aplayer .aplayer-lrc p {
        <%if(theme.music.hideLrc){%>
        display: none;
        <%}%>
        font-size: 12px;
        font-weight: 700;
        line-height: 16px !important;
    }

    .aplayer .aplayer-lrc p.aplayer-lrc-current {
        <%if(theme.music.hideLrc){%>
        display: none;
        <%}%>
        font-size: 15px;
        color: <%- theme.music.theme %>;
    }

    <%if(theme.music.autoHide){%>
    .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body {
        left: -66px !important;
    }

    .aplayer.aplayer-fixed.aplayer-narrow .aplayer-body:hover {
        left: 0px !important;
    }

    <%}%>

    #persistent-music-player,
    #persistent-music-player > div,
    #persistent-music-player .row,
    #persistent-music-player meting-js {
        background: transparent !important;
        box-shadow: none !important;
        margin: 0 !important;
        padding: 0 !important;
        height: 0 !important;
        min-height: 0 !important;
        overflow: visible !important;
    }

    #persistent-music-player .aplayer.aplayer-fixed .aplayer-body {
        bottom: 20vh;
        left: 0;
    }

    #persistent-music-player .aplayer.aplayer-fixed .aplayer-list {
        bottom: calc(20vh + 66px);
        left: 0;
        margin: 0;
        transform: none !important;
    }

    #persistent-music-player .aplayer.aplayer-fixed .aplayer-lrc {
        bottom: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
    }
</style>
<div class="<% if(!theme.music.fixed) { %>music-player<% } %>">
    <% if (!theme.music.fixed && theme.music.title.enable) { %>
        <div class="title center-align">
            <i class="fas fa-music"></i>&nbsp;&nbsp;<%- theme.music.title.show %>
        </div>
    <% } %>
    <div class="row">
        <meting-js class="persistent-meting-player col l8 offset-l2 m10 offset-m1 s12"
                   data-persistent-player="true"
                   server="<%- theme.music.server %>"
                   type="<%- theme.music.type %>"
                   id="<%- theme.music.id %>"
                   fixed='<%- theme.music.fixed ? 'true' : 'false' %>'
                   autoplay='<%- page.layout === 'musics' || page.type === 'musics' ? 'false' : theme.music.autoplay === true %>'
                   theme='<%- theme.music.theme %>'
                   loop='<%- theme.music.loop %>'
                   order='<%- theme.music.order %>'
                   preload='<%- theme.music.preload %>'
                   volume='<%- Number(theme.music.volume) %>'
                   list-folded='<%- theme.music.listFolded ? 'true' : 'false' %>'
        >
        </meting-js>
    </div>
</div>

<script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.aplayer) %>"></script>
<script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.meting) %>"></script>

<script>
(function() {
    // 等待播放器初始化完成
    var initTimer = setInterval(function() {
        var playerContainer = document.getElementById('persistent-music-player');
        if (!playerContainer) return;

        var aplayerBody = playerContainer.querySelector('.aplayer.aplayer-fixed .aplayer-body');
        var aplayerList = playerContainer.querySelector('.aplayer.aplayer-fixed .aplayer-list');
        var aplayerButton = playerContainer.querySelector('.aplayer-button');

        if (!aplayerBody) return;

        clearInterval(initTimer);

        // 添加拖拽样式和过渡动画
        aplayerBody.style.cursor = 'grab';
        aplayerBody.style.userSelect = 'none';
        aplayerBody.style.transition = 'left 0.3s ease, bottom 0.15s ease';
        if (aplayerList) {
            aplayerList.style.transition = 'left 0.3s ease, bottom 0.15s ease';
        }
        if (aplayerButton) {
            aplayerButton.style.cursor = 'pointer';
        }

        // 拖拽状态
        var isDragging = false;
        var startX, startY;
        var startBottom;
        var currentBottom = 20; // vh 单位，始终在左侧

        // 更新播放器和列表位置（垂直方向）
        function updateVerticalPosition(bottomVh) {
            bottomVh = Math.max(5, Math.min(bottomVh, 90));
            currentBottom = bottomVh;

            // 始终在左侧
            aplayerBody.style.left = '0px';
            aplayerBody.style.bottom = bottomVh + 'vh';

            if (aplayerList) {
                aplayerList.style.left = '0px';
                aplayerList.style.bottom = 'calc(' + bottomVh + 'vh + 66px)';
            }

            // 只保存垂直位置
            try {
                localStorage.setItem('aplayer_bottom', bottomVh);
            } catch(e) {}
        }

        // 拖拽时的临时位置（允许左右移动）
        function setDragPosition(leftPx, bottomVh) {
            var maxLeft = window.innerWidth - 66;
            leftPx = Math.max(0, Math.min(leftPx, maxLeft));
            bottomVh = Math.max(5, Math.min(bottomVh, 90));

            // 拖拽时禁用过渡动画
            aplayerBody.style.transition = 'none';
            if (aplayerList) {
                aplayerList.style.transition = 'none';
            }

            aplayerBody.style.left = leftPx + 'px';
            aplayerBody.style.bottom = bottomVh + 'vh';

            if (aplayerList) {
                aplayerList.style.left = leftPx + 'px';
                aplayerList.style.bottom = 'calc(' + bottomVh + 'vh + 66px)';
            }
        }

        // 吸附回左侧
        function snapToLeft(bottomVh) {
            // 启用过渡动画
            aplayerBody.style.transition = 'left 0.3s ease, bottom 0.15s ease';
            if (aplayerList) {
                aplayerList.style.transition = 'left 0.3s ease, bottom 0.15s ease';
            }

            updateVerticalPosition(bottomVh);
        }

        // 恢复保存的位置
        function restorePosition() {
            try {
                var savedBottom = localStorage.getItem('aplayer_bottom');
                if (savedBottom) {
                    updateVerticalPosition(parseFloat(savedBottom));
                }
            } catch(e) {}
        }

        setTimeout(restorePosition, 500);

        // 拖拽阈值（移动超过这个距离才认为是拖拽）
        var DRAG_THRESHOLD = 10;
        var hasDragged = false;

        // 鼠标/触摸事件处理
        function onDragStart(e) {
            // 排除播放按钮点击
            if (e.target.closest && e.target.closest('.aplayer-button')) return;
            if (e.target.classList && e.target.classList.contains('aplayer-button')) return;

            isDragging = true;
            hasDragged = false;
            aplayerBody.style.cursor = 'grabbing';
            startBottom = currentBottom;

            if (e.type === 'touchstart') {
                startX = e.touches[0].clientX;
                startY = e.touches[0].clientY;
            } else {
                startX = e.clientX;
                startY = e.clientY;
            }
        }

        function onDragMove(e) {
            if (!isDragging) return;

            var clientX, clientY;
            if (e.type === 'touchmove') {
                clientX = e.touches[0].clientX;
                clientY = e.touches[0].clientY;
            } else {
                clientX = e.clientX;
                clientY = e.clientY;
            }

            var deltaX = clientX - startX;
            var deltaY = startY - clientY;

            // 只有移动超过阈值才认为是拖拽，并阻止默认行为
            if (Math.abs(deltaX) > DRAG_THRESHOLD || Math.abs(deltaY) > DRAG_THRESHOLD) {
                hasDragged = true;
                e.preventDefault();
            }

            if (hasDragged) {
                var vhPerPixel = 100 / window.innerHeight;
                var deltaVh = deltaY * vhPerPixel;
                setDragPosition(deltaX, startBottom + deltaVh);
            }
        }

        function onDragEnd(e) {
            if (!isDragging) return;
            isDragging = false;
            aplayerBody.style.cursor = 'grab';

            // 只有真正拖拽过才吸附回左侧
            if (hasDragged) {
                var currentBottomVh = parseFloat(aplayerBody.style.bottom) || currentBottom;
                snapToLeft(currentBottomVh);
            }
        }

        // 绑定事件
        aplayerBody.addEventListener('mousedown', onDragStart);
        document.addEventListener('mousemove', onDragMove);
        document.addEventListener('mouseup', onDragEnd);

        aplayerBody.addEventListener('touchstart', onDragStart, { passive: true });
        document.addEventListener('touchmove', onDragMove, { passive: false });
        document.addEventListener('touchend', onDragEnd);
    }, 100);
})();
</script>
