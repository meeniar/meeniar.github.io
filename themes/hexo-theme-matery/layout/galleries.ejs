<link rel="stylesheet" href="<%- theme.jsDelivr.url %><%- url_for(theme.libs.css.gallery) %>">

<%- partial('_partial/bg-cover') %>

<main class="content">
    <div class="container">
        <div class="gallery-intro">
            <p>凡我所失，皆非我所有，凡我所求，皆受其所困，万物皆为我所用，但非我所属。君子使物，不为物使。大道至简，无欲则刚。无为则无所不为。</p>
        </div>
        <% if (site.data && site.data.galleries) { %>
        <% var galleries = site.data.galleries; %>
        <div class="gallery-wrapper">
            <% for (var i = 0, len = galleries.length; i < len; i++) { %>
            <% var gallery = galleries[i]; %>
            <div class="gallery-card">
                <a href="./<%- gallery.name %>">
                    <div class="gallery-card-cover" style="background-image: url(<%- theme.jsDelivr.url %><%- gallery.cover%>);">
                        <div class="gallery-card-overlay"></div>
                        <div class="gallery-card-info">
                            <h3><%- gallery.name %></h3>
                            <p><%- gallery.description %></p>
                        </div>
                    </div>
                </a>
            </div>
            <% } %>
        </div>
        <% } %>
    </div>
</main>
